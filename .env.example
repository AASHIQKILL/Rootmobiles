# Copy this file to .env.local and fill in real values.
# The site runs fully on local mock data (src/lib/data) when these are unset.

# Supabase — https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary — https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Maps embed (optional — falls back to a keyless embed URL)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Site URL used for metadata / JSON-LD / sitemap
NEXT_PUBLIC_SITE_URL=https://rootmobiles.in
